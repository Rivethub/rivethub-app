{
  "name": "rivethub-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "dev:desktop": "pnpm --filter @rivethub/desktop dev:desktop",
    "build:desktop": "pnpm --filter @rivethub/desktop... build",
    "test:desktop": "pnpm --filter @rivethub/desktop test:e2e",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
