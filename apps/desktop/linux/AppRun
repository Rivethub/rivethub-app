#!/usr/bin/env bash
# The AppImage's entry point, in place of electron-builder's AppRun. That one adds --no-sandbox
# whenever `unshare -Ur true` fails, so on hosts that restrict unprivileged user namespaces
# (Ubuntu 24.04's AppArmor default, hardened kernels) the app ran without Chromium's sandbox.
# This one never adds --no-sandbox: on those hosts it refuses to start and points at the .deb,
# whose AppArmor profile lets the sandbox run.
set -eu

if [ -z "${APPDIR:-}" ]; then
  APPDIR="$(dirname "$(readlink -f "$0")")"
fi

# Probe before PATH and LD_LIBRARY_PATH point into the AppImage, so the host's own tools run.
if ! unshare -Ur true >/dev/null 2>&1; then
  message="RivetHub can't run sandboxed from the AppImage on this system, because it doesn't allow unprivileged user namespaces. Install the .deb from https://rivethub.io instead."
  echo "rivethub: $message" >&2
  if command -v notify-send >/dev/null 2>&1; then
    notify-send --app-name=RivetHub --urgency=critical "RivetHub can't start" "$message" >/dev/null 2>&1 || true
  elif command -v zenity >/dev/null 2>&1; then
    zenity --error --title="RivetHub can't start" --text="$message" >/dev/null 2>&1 || true
  fi
  exit 1
fi

export PATH="${APPDIR}:${APPDIR}/usr/sbin${PATH:+:${PATH}}"
export XDG_DATA_DIRS="${APPDIR}/usr/share/${XDG_DATA_DIRS:+:${XDG_DATA_DIRS}}:/usr/share/gnome:/usr/local/share/:/usr/share/"
export LD_LIBRARY_PATH="${APPDIR}/usr/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
export GSETTINGS_SCHEMA_DIR="${APPDIR}/usr/share/glib-2.0/schemas${GSETTINGS_SCHEMA_DIR:+:${GSETTINGS_SCHEMA_DIR}}"

exec "${APPDIR}/rivethub" "$@"
