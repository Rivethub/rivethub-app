{
  "name": "@rivethub/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "productName": "RivetHub",
  "main": "dist-electron/boot.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev:desktop": "node scripts/dev.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @rivethub/desktop... build && playwright test"
  },
  "dependencies": {
    "@rivethub/contracts": "workspace:*",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@rivethub/web": "workspace:*",
    "@types/node": "22.20.5",
    "electron": "45.2.3",
    "esbuild": "0.28.2",
    "typescript": "~5.9.3",
    "vitest": "5.0.5"
  }
}
