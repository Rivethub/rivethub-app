{
  "expo": {
    "name": "RivetHub",
    "slug": "rivethub",
    "scheme": "rivethub",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "android": {
      "package": "app.rivethub.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#2d353b"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "RivetHub uses the camera to scan a hub pairing code."
        }
      ],
      "./plugins/withUserCa.js"
    ]
  }
}
