{
  "expo": {
    "name": "RivetHub",
    "slug": "rivethub",
    "scheme": "rivethub",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "android": {
      "package": "app.rivethub.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#181e1b"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "RivetHub uses the camera to scan a hub pairing code."
        }
      ],
      "./plugins/withUserCa.js",
      "./plugins/withReleaseSigning.js"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#181e1b"
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#181e1b"
    }
  }
}
