# Required. Postgres connection string.
DATABASE_URL=postgres://rivethub:rivethub@127.0.0.1:5432/rivethub_cloud
# Base URL used in magic links.
PUBLIC_URL=https://rivethub.cloud
# Optional. Without it, magic links are logged to stdout (dev mode) and no email is sent.
RESEND_API_KEY=
EMAIL_FROM="RivetHub <hello@rivethub.cloud>"
PORT=8080
# Bind address. Keep loopback when a reverse proxy sits in front.
HOST=127.0.0.1
# Set to 1 only behind a proxy that overwrites X-Forwarded-For. Used for rate limiting; IPs are never stored or logged.
TRUST_PROXY=0
# Required in production (NODE_ENV=production or RESEND_API_KEY set), 16+ chars. Keys the HMAC that anonymises install ids. Keep it secret and stable.
TELEMETRY_SALT=
# Crash and usage rows older than this are deleted.
TELEMETRY_RETENTION_DAYS=90
